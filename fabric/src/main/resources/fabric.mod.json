{
  "schemaVersion": 1,
  "id": "chaosgravestone",
  "version": "${version}",
  "name": "Chaos Gravestone",
  "description": "Al morir queda una lápida protegida con todo tu inventario; al abrirla cada objeto vuelve a su ranura. Incluye brújula de calavera que guía hasta la tumba y versión de ender que teletransporta.",
  "authors": [
    "${mod_author}"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.chaos.gravestone.ChaosGravestoneFabric"
    ],
    "client": [
      "com.chaos.gravestone.client.ChaosGravestoneFabricClient"
    ]
  },
  "mixins": [
    "chaosgravestone.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.1",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "accessories": "*",
    "trinkets": "*",
    "travelersbackpack": "*",
    "cosmeticarmorreworked": "*"
  }
}
